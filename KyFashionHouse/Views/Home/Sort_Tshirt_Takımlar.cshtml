
@{
    ViewBag.Title = "Sort_Tshirt_Takımlar";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<!-- SHORT SET CATEGORY START -->
<div class="container-fluid pt-5">
    <div class="text-center mb-4">
        <h2 class="section-title px-5">
            <span class="px-2">Şort Tişört Takımları</span>
        </h2>
    </div>

    <div class="row px-xl-5">

        <!-- SOL FİLTRE -->
        <div class="col-lg-3 col-md-12">
            <div class="border p-4 mb-4">
                <h5 class="font-weight-bold mb-3">Filtrele</h5>

                <h6 class="font-weight-bold">Beden</h6>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="setS">
                    <label class="custom-control-label" for="setS">S</label>
                </div>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="setM">
                    <label class="custom-control-label" for="setM">M</label>
                </div>
                <div class="custom-control custom-checkbox mb-3">
                    <input type="checkbox" class="custom-control-input" id="setL">
                    <label class="custom-control-label" for="setL">L</label>
                </div>

                <h6 class="font-weight-bold">Fiyat</h6>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="price1">
                    <label class="custom-control-label" for="price1">₺0 - ₺300</label>
                </div>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="price2">
                    <label class="custom-control-label" for="price2">₺300 - ₺600</label>
                </div>
            </div>
        </div>

        <!-- ÜRÜNLER -->
        <div class="col-lg-9 col-md-12">
            <div class="row pb-3">

                <!-- ÜRÜN 1 -->
                <div class="col-lg-4 col-md-6 col-sm-12 pb-1">
                    <div class="card product-item border-0 mb-4">
                        <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
                            <img class="img-fluid w-100" src="img/Ck Beyaz şort T-sHİRT.jpeg" alt="">
                        </div>
                        <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
                            <h6 class="text-truncate mb-3">CK Beyaz Şort Tişört Takım</h6>
                            <div class="d-flex justify-content-center">
                                <h6>₺349</h6>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between bg-light border">
                            <a href="" class="btn btn-sm text-dark p-0">
                                <i class="fas fa-eye text-primary mr-1"></i>Detay
                            </a>
                            <a href="" class="btn btn-sm text-dark p-0">
                                <i class="fas fa-shopping-cart text-primary mr-1"></i>Sepete Ekle
                            </a>
                        </div>
                    </div>
                </div>

                <!-- ÜRÜN 2 -->
                <div class="col-lg-4 col-md-6 col-sm-12 pb-1">
                    <div class="card product-item border-0 mb-4">
                        <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
                            <img class="img-fluid w-100" src="img/product-2.jpg" alt="">
                        </div>
                        <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
                            <h6 class="text-truncate mb-3">Siyah Şort Tişört Takım</h6>
                            <div class="d-flex justify-content-center">
                                <h6>₺399</h6>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between bg-light border">
                            <a href="" class="btn btn-sm text-dark p-0">
                                <i class="fas fa-eye text-primary mr-1"></i>Detay
                            </a>
                            <a href="" class="btn btn-sm text-dark p-0">
                                <i class="fas fa-shopping-cart text-primary mr-1"></i>Sepete Ekle
                            </a>
                        </div>
                    </div>
                </div>

                <!-- ÜRÜN 3 -->
                <div class="col-lg-4 col-md-6 col-sm-12 pb-1">
                    <div class="card product-item border-0 mb-4">
                        <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
                            <img class="img-fluid w-100" src="img/product-3.jpg" alt="">
                        </div>
                        <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
                            <h6 class="text-truncate mb-3">Baskılı Şort Takım</h6>
                            <div class="d-flex justify-content-center">
                                <h6>₺429</h6>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between bg-light border">
                            <a href="" class="btn btn-sm text-dark p-0">
                                <i class="fas fa-eye text-primary mr-1"></i>Detay
                            </a>
                            <a href="" class="btn btn-sm text-dark p-0">
                                <i class="fas fa-shopping-cart text-primary mr-1"></i>Sepete Ekle
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
<!-- SHORT SET CATEGORY END -->
